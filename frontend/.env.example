# ─── Backend API ───
# Local development. Leave unset in deployed builds and the app automatically
# targets the production backend (https://cutc-intelliapply.onrender.com)
# via frontend/lib/config.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Supabase (required for sign-in) ───
# Both values are inlined into the client bundle at build time. The anon key is
# a publishable key and is safe to expose to the browser — Row Level Security is
# what protects the data. Never put the service role key here.
#
# Without these, the app still works fully (resume parsing, job extraction,
# analysis) but the Sign In button will report that accounts are unavailable.
#
# For the deployed site these are read from GitHub repository secrets in
# .github/workflows/deploy-frontend.yml.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
